---
import '@fontsource/fira-sans/400.css';
import '@fontsource/fira-sans/500.css';
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  image?: { url: string; width: number; height: number; alt: string };
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const { title, description, image, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// JSON-LD is data in a script tag; escape < so text can never close the tag
const ld = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#0d0d0d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="sbtlTV" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image.url} />}
    {image && <meta property="og:image:width" content={String(image.width)} />}
    {image && <meta property="og:image:height" content={String(image.height)} />}
    {image && <meta property="og:image:alt" content={image.alt} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    {ld && <script is:inline type="application/ld+json" set:html={ld} />}
  </head>
  <body>
    {/* Something playing behind the page, blurred, like the player behind the guide */}
    <div class="backdrop" aria-hidden="true">
      <img class="still" src="/media/bg-poster.webp" alt="" width="640" height="360" />
      <video autoplay muted loop playsinline preload="auto" poster="/media/bg-poster.webp" disablepictureinpicture>
        <source src="/media/bg.webm" type="video/webm" />
        <source src="/media/bg.mp4" type="video/mp4" />
      </video>
    </div>
    <slot />
  </body>
</html>
